{
  "name": "rta-smriti-brain-dashboard",
  "version": "1.0.3-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:launch": "vite --config vite.launch.config.js --host 127.0.0.1",
    "build": "vite build",
    "build:launch": "vite build --config vite.launch.config.js",
    "capture:launch-assets": "node scripts/capture_launch_assets.mjs",
    "capture:product-screenshots": "node scripts/capture_product_screenshots.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test operator-tests/dashboard-security.test.mjs",
    "test:operator": "playwright test --config playwright.config.mjs",
    "test:launch": "node scripts/launch_site_qa.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
